  "use strict";

  // 1. IDEMPOTENCY: Prevent the code from running twice if the snippet re-evaluates

  // We attach this to the window object to be safe from body loading delays

  if (window.optiSocialReviewsApplied) return;

  window.optiSocialReviewsApplied = true;

  // 2. INITIALIZE OPTIMIZELY UTILS

  const utils =
    window.optimizely && window.optimizely.get
      ? window.optimizely.get("utils")
      : null;

  if (!utils) {
    console.warn("Optimizely utils not found.");

    return;
  }

  // 3. Translate all read more buttons

  const TRANSLATIONS = {
    ".vn": {
      reviewTitle: "Tóm tắt đánh giá",
 
      seeAll: "Xem tất cả đánh giá",
 
      readMore: "Đọc thêm",
 
      readLess: "Thu gọn",
    },
 
    ".th": {
      reviewTitle: "สรุปรีวิว",
 
      seeAll: "ดูรีวิวทั้งหมด",
 
      readMore: "อ่านเพิ่มเติม",
 
      readLess: "อ่านน้อยลง",
    },
 
    ".tw": {
      reviewTitle: "評論摘要",
 
      seeAll: "查看所有評論",
 
      readMore: "閱讀更多",
 
      readLess: "收起",
    },
 
    ".kr": {
      reviewTitle: "리뷰 요약",
 
      seeAll: "모든 리뷰 보기",
 
      readMore: "더 읽기",
 
      readLess: "접기",
    },
 
    default: {
      reviewTitle: "Review Summary",
 
      seeAll: "See all reviews",
 
      readMore: "Read more",
 
      readLess: "Read less",
    },
  };

  function getTranslations() {
    const hostname = window.location.hostname;
    const pathname = window.location.pathname; // Gets the path, e.g., '/en-vn/'

    // 1. Check if the URL path contains the English language route
    if (pathname.includes("/en-vn")) {
      return TRANSLATIONS.default;
    }

    // 2. Otherwise, fall back to checking the domain TLD
    const matched = Object.keys(TRANSLATIONS).find(
      (tld) => hostname.endsWith(tld) && tld !== "default"
    );

    return TRANSLATIONS[matched] || TRANSLATIONS.default;
  }

  function translateText() {
    const t = getTranslations();

    const elements = {
      "tooltip-info-bottom-reviews--title": t.reviewTitle,

      "tooltip-info-bottom-reviews-see-all-reviews": t.seeAll,
    };

    Object.entries(elements).forEach(([id, text]) => {
      const el = document.getElementById(id);

      if (el) el.textContent = text;
    });

    document
      .querySelectorAll(".services-tooltip__body__toggle")
      .forEach((btn) => {
        btn.textContent = t.readMore;
      });
  }

  // 4. CORE FUNCTIONS

  function loadReviewsScript(review) {
    if (!review || !review.dataset.scriptUrl) return;

    // Check if already injected to prevent duplicates

    if (document.getElementById(review.dataset.scriptId)) return;

    const scriptUrl = review.dataset.scriptUrl;

    const script = document.createElement("script");

    script.src = scriptUrl;

    script.id = review.dataset.scriptId;

    // Safely append to head in case body isn't ready

    document.head.appendChild(script);
  }

  function initSocialReviewsExperiment(ratingElement) {
    if (
      !ratingElement ||
      ratingElement.querySelector(".tooltip-info-bottom-reviews")
    )
      return;

    // ✅ GET REVIEW COUNT
    const ratingTextElement = document.querySelector(".rating_rating");

    let reviewCount = 0;

    if (ratingTextElement) {
      const match = ratingTextElement.innerText.match(/\d+/);
      reviewCount = match ? parseInt(match[0], 10) : 0;
    }

    // ✅ CONDITION: Do not create tooltip if < 5 reviews
    if (reviewCount < 5) return;

    // ✅ Existing logic continues
    ratingElement.classList.add("tooltip-link", "tooltip-link--hover-all");

    const tooltip = document.createElement("div");
    tooltip.className = "tooltip-info-bottom tooltip-info-bottom-reviews";

    tooltip.innerHTML = `
    <svg viewBox="0 0 48 48" data-close-modal-button="" class="v-modal__close-btn"><use xlink:href="/Static/css/themes/electrolux/icons/icons.svg#close-icon"></use></svg>
<h5 id="tooltip-info-bottom-reviews--title" class="tooltip-info-bottom-reviews--title">Review Summary</h5>
<div id="product-details_heading_rating--inner"></div>
<div class="tooltip-info-bottom-reviews--see-all">
<a id="tooltip-info-bottom-reviews-see-all-reviews" href="#reviews">
See all reviews
</a>
</div>
    `;

    ratingElement.appendChild(tooltip);
  }

  function transformRelatedServices(ul) {
    if (
      !ul ||
      ul.classList.contains("product-hero-heading-services-grid-wrapper")
    )
      return;

    const container = document.createElement("div");

    container.className =
      "product-details_heading__related-service product-hero-heading-services-grid-wrapper list-style-type-none mgt-sm-10 mgt-md-20";

    ul.querySelectorAll("li.tooltip-link").forEach((li) => {
      const linkElement = li.querySelector("a");

      const link = linkElement ? linkElement.href : "";

      const iconImg = li.querySelector("img.related-service-icon");

      const iconSrc = iconImg ? iconImg.src : "";

      const textElement = li.querySelector("span");

      const text = textElement
        ? textElement.textContent.trim()
        : li.textContent.trim();

      const tooltipInfo = li.querySelector("p.tooltip-info");

      const tooltipText = tooltipInfo ? tooltipInfo.textContent.trim() : "";

      // GRID wrapper with tooltip-link

      const grid = document.createElement("div");

      grid.className = "product-hero-heading-services-grid tooltip-link";

      // CARD

      const card = document.createElement("div");

      card.className = "product-hero-heading-services-card";

      card.innerHTML = `
<div class="product-hero-heading-services-card-label-wrapper">
    ${link ? `<a href="${link}" class="product-hero-heading-services-card-label-wrapper product-hero-heading-services-card-label">` : ""}
        <img class="related-service-icon" src="${iconSrc}" alt="${text} icon" width="25" height="25">
        <div class="services-tooltip__title">${text}</div>
    ${link ? `</a>` : ""}
</div>`;
    

      grid.appendChild(card);

      // TOOLTIP if exists

      if (tooltipText) {
        const tooltip = document.createElement("div");

        tooltip.className = "tooltip-info-above services-tooltip__body";

        const t = getTranslations();

        tooltip.innerHTML = `
<div class="services-tooltip-inner__title">${text}</div>
<div class="services-tooltip__body__text">${tooltipText}</div>
<button id="services-tooltip__body__toggle" class="services-tooltip__body__toggle">${t.readMore}</button>
 
                `;

        grid.appendChild(tooltip);
      }

      container.appendChild(grid);
    });

    ul.replaceWith(container);

    // Run after layout

    requestAnimationFrame(() => {
      handleTruncatedTooltips();
    });

    // Re-check on resize

    window.addEventListener("resize", handleTruncatedTooltips);
  }

  function handleTruncatedTooltips() {
    document
      .querySelectorAll(".services-tooltip__body__text")
      .forEach((textEl) => {
        const tooltip = textEl.closest(".services-tooltip__body");

        const parent = textEl.parentElement;

        const existingToggle = parent.querySelector(
          ".services-tooltip__body__toggle"
        );

        if (existingToggle) existingToggle.remove();

        // Temporarily show tooltip so it can be measured

        const prevDisplay = tooltip.style.display;

        const prevVisibility = tooltip.style.visibility;

        tooltip.style.display = "block";

        tooltip.style.visibility = "hidden";

        // Remove clamp to measure full height

        const prevClamp = textEl.style.webkitLineClamp;

        textEl.style.webkitLineClamp = "unset";

        const fullHeight = textEl.scrollHeight;

        // Restore clamp

        textEl.style.webkitLineClamp = prevClamp;

        const clampedHeight = textEl.clientHeight;

        // Restore tooltip state

        tooltip.style.display = prevDisplay;

        tooltip.style.visibility = prevVisibility;

        if (fullHeight > clampedHeight + 2) {
          const button = document.createElement("button");

          button.className = "services-tooltip__body__toggle";

          button.textContent = "Read more";

          parent.appendChild(button);
        }
      });
  }

  // Retained explicit user copyReviews function

  function copyReviews() {
    const observer = new MutationObserver(() => {
      const source = document.querySelector(".tf-distribution");

      const target = document.getElementById(
        "product-details_heading_rating--inner"
      );

      if (source && target) {
        observer.disconnect();

        // Function to copy computed styles recursively

        function cloneWithStyles(element) {
          const clone = element.cloneNode(true);

          const nodes = element.querySelectorAll("*");

          const clones = clone.querySelectorAll("*");

          // Copy computed styles for each element

          nodes.forEach((node, i) => {
            const style = window.getComputedStyle(node);

            for (let prop of style) {
              clones[i].style[prop] = style.getPropertyValue(prop);
            }
          });

          return clone;
        }

        // Clear target and append styled clone

        target.innerHTML = "";

        const styledClone = cloneWithStyles(source);

        target.appendChild(styledClone);
      }
    });

    // Safe to observe body because it's called inside a utils.waitForElement('body') block

    observer.observe(document.body, { childList: true, subtree: true });
  }

  // 4. EVENT DELEGATION

  // Read more / Read less toggle (only if text is truncated)

  document.addEventListener("click", function (e) {
    const toggle = e.target.closest(".services-tooltip__body__toggle");

    if (!toggle) return;

    const text = toggle.previousElementSibling;

    if (!text) return;

    const t = getTranslations();

    const isExpanded = text.classList.toggle("is-expanded");

    toggle.textContent = isExpanded ? t.readLess : t.readMore;
  });

  function isMobileDevice() {
    return (
      window.matchMedia("(pointer: coarse)").matches ||
      navigator.maxTouchPoints > 0
    );
  }

  // 5. EXECUTION BLOCK

  utils
    .waitForElement(".review-container.js_load-script")
    .then(function (element) {
      loadReviewsScript(element);
    });

  utils
    .waitForElement(".product-details_heading_rating")
    .then(function (element) {
      initSocialReviewsExperiment(element);

      translateText();
    });

  utils
    .waitForElement("ul.product-details_heading__related-service")
    .then(function (element) {
      transformRelatedServices(element);
    });

  // Wait for the body to exist before starting the copyReviews observer to prevent "Cannot read properties of null" errors

  utils.waitForElement("body").then(function () {
    copyReviews();

    translateText();
  });
  
  utils.waitForElement('.product-details_heading_rating').then(function () {
      if (!isMobileDevice()) return;

      // OPTIMIZATION: Single delegated listener instead of multiple loops
      document.addEventListener('click', function (e) {
          
          // 1. Handle "Close Icon" Tap
          const closeBtn = e.target.closest('.v-modal__close-btn');
          if (closeBtn) {
              e.preventDefault();
              e.stopImmediatePropagation();
              
              const parentTooltip = closeBtn.closest('.tooltip-info-bottom-reviews');
              if (parentTooltip) {
                  parentTooltip.classList.remove('is-visible');
                  // Force hide to prevent CSS hover conflicts
                  parentTooltip.style.setProperty('display', 'none', 'important');
                  setTimeout(() => parentTooltip.style.removeProperty('display'), 300);
              }
              return; 
          }

          // 2. Handle "Rating Stars" Tap (Task 2: Changed target)
          const ratingStars = e.target.closest('.rating_stars');
          if (ratingStars) {
              e.preventDefault();
              e.stopPropagation();

              // Traverse up to find the container, then find the specific tooltip
              const container = ratingStars.closest('.product-details_heading_rating');
              if (container) {
                  const tooltip = container.querySelector('.tooltip-info-bottom-reviews');
                  if (tooltip) {
                      tooltip.classList.toggle('is-visible');
                  }
              }
              return; 
          }

          // 3. Handle "Click Outside" (Close open tooltips)
          const openTooltips = document.querySelectorAll('.tooltip-info-bottom-reviews.is-visible');
          openTooltips.forEach(t => {
              if (!t.closest('.product-details_heading_rating').contains(e.target)) {
                  t.classList.remove('is-visible');
              }
          });

      }, true); // 'true' = Capture phase, stops other scripts from blocking this
  });
  
})();
}, "dependencies": []}, {"id": "BBC74C12-5FD8-4601-B5B1-F99817BD206D", "type": "append", "selector": "head", "value": "<style>.tooltip-info-bottom-reviews--title {\n\ttext-align: left;\n\tpadding: 0 10px 10px;\n\tmargin: 0;\n}\n\n.tooltip-info-bottom-reviews--see-all {\n\tpadding: 10px 10px 0;\n\ttext-align: left;\n\twidth: 100%;\n\tbox-sizing: border-box;\n}\n\n.tooltip-info-bottom-reviews--see-all a {\n\tfont-size: 14px;\n\ttext-decoration: underline;\n\tdisplay: inline-block;\n\tmax-width: 100%;\n}\n\n#product-details_heading_rating--inner {\n\tfont-size: 14px;\n\twidth: 100%;\n\tmax-width: 100% !important;\n\tpadding: 0 50px 0 8px;\n\tbox-sizing: border-box;\n\ttransform: translateX(-20px);\n\toverflow: visible;\n}\n\n#product-details_heading_rating--inner .tf-dist-user table, #product-details_heading_rating--inner .tf-dist-all table {\n\tmax-width: 150px !important;\n\tborder-collapse: collapse;\n}\n\n#product-details_heading_rating--inner .tf-dist-user tr, #product-details_heading_rating--inner .tf-dist-all tr {\n\tdisplay: table-row;\n}\n\n#product-details_heading_rating--inner .tf-dist-user td, #product-details_heading_rating--inner .tf-dist-all td {\n\tvertical-align: middle;\n\tpadding: 3px 0;\n\tfont-size: 13px;\n\tcolor: #666;\n\tmax-width: 150px !important;\n}\n\n#product-details_heading_rating--inner .tf-dist-user .range, #product-details_heading_rating--inner .tf-dist-all .range {\n\ttext-align: center;\n\twidth: 20px;\n}\n\n#product-details_heading_rating--inner .tf-dist-user .sym, #product-details_heading_rating--inner .tf-dist-all .sym {\n\tpadding-right: 6px;\n}\n\n#product-details_heading_rating--inner .tf-dist-user .bar, #product-details_heading_rating--inner .tf-dist-all .bar {\n\tpadding: 0 8px;\n\tmax-width: 150px !important;\n}\n\n#product-details_heading_rating--inner .tf-dist-user .fill, #product-details_heading_rating--inner .tf-dist-all .fill {\n\tbackground: #f2f2f2;\n\tborder-radius: 6px;\n\theight: 10px;\n\tmax-width: 150px !important;\n}\n\n#product-details_heading_rating--inner .tf-dist-user .bin, #product-details_heading_rating--inner .tf-dist-all .bin {\n\tbackground: #B88923 ;\n\theight: 10px;\n\tborder-radius: 6px;\n\tmax-width: 150px !important;\n}\n\n#product-details_heading_rating--inner .tf-dist-user .percent, #product-details_heading_rating--inner .tf-dist-all .percent {\n\ttext-align: right;\n\twidth: 40px;\n}\n\n.product-hero-heading-services-grid-wrapper,\n.product-details_heading__related-service {\n\tdisplay: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 10px;\n\n\t@media (max-width: 1020px) {\n\t\tpadding: 15px;\n\t}\n}\n\n.product-hero-heading-services-grid-wrapper .product-hero-heading-services-grid,\n.product-details_heading__related-service .product-hero-heading-services-grid {\n\tgrid-column: span 1;\n}\n\n/* Single item should take only 50% width */\n.product-hero-heading-services-grid:only-child {\n\twidth: 100%;\n\tmax-width: calc(50% - 5px);\n}\n\n.product-hero-heading-services-grid-wrapper .tooltip-link:hover .tooltip-info-above.services-tooltip__body,\n.product-hero-heading-services-grid-wrapper .tooltip-link:focus-within .tooltip-info-above.services-tooltip__body,\n.product-details_heading__related-service .tooltip-link:hover .tooltip-info-above.services-tooltip__body,\n.product-details_heading__related-service .tooltip-link:focus-within .tooltip-info-above.services-tooltip__body {\n\tdisplay: block;\n}\n\n/* Extra description inside tooltip-link */\n.tooltip-link .extra-description {\n\tborder-bottom: 1px dashed;\n}\n\n/* Tooltip info inside tooltip-link */\n.tooltip-link .tooltip-info-above {\n\tdisplay: none;\n\tposition: absolute;\n\tpadding: 15px;\n\tbackground-color: white;\n\tborder: 1px solid rgba(1, 30, 65, 0.1);\n\tborder-radius: 5px;\n\tleft: 20px;\n\tfont-size: 14px;\n\tz-index: 1000;\n\tbottom: 45px;\n}\n\n/* Arrow after tooltip-info */\n.tooltip-link .tooltip-info-above::after {\n\tdisplay: block;\n\tposition: absolute;\n\tbackground-color: white;\n\tcontent: '';\n\twidth: 12px;\n\theight: 12px;\n\t-ms-transform: rotate(46deg);\n\ttransform: rotate(46deg);\n\tborder: 1px solid rgba(1, 30, 65, 0.1);\n\tleft: 0;\n\tmargin-left: 6px;\n\tborder-top: none;\n\tborder-left: none;\n\tbottom: -6px;\n}\n\n.tooltip-link .tooltip-info-bottom {\n\tdisplay: none;\n\tposition: absolute;\n\tpadding: 15px;\n\twidth: 280px;\n\tbackground-color: white;\n\tborder: 1px solid rgba(1, 30, 65, 0.1);\n\tborder-radius: 5px;\n\tleft: 10px;\n\tfont-size: 11px;\n\tz-index: 9999999;\n\ttop: 45px;\n}\n\n.tooltip-link--hover-all:hover .tooltip-info-bottom,\n.tooltip-link--hover-all:focus-within .tooltip-info-bottom {\n\tdisplay: block;\n}\n\n.tooltip-info-bottom-reviews {\n\tleft: 92px !important;\n\ttop: 25px !important;\n\tposition: absolute;\n\ttext-align: left;\n\n\t/* Remove inherited/default arrow */\n\t&::after {\n\t\tdisplay: none !important;\n\t\tcontent: none !important;\n\t}\n\n\t/* Single top arrow */\n\t&::before {\n\t\tcontent: '';\n\t\tposition: absolute;\n\t\twidth: 12px;\n\t\theight: 12px;\n\t\tbackground-color: white;\n\n\t\ttransform: rotate(45deg);\n\n\t\tborder: 1px solid rgba(1, 30, 65, 0.1);\n\t\tborder-right: none;\n\t\tborder-bottom: none;\n\n\t\ttop: -7px;\n\t\tleft: 18px;\n\n\t\tz-index: 1;\n\t}\n}\n\n.tooltip-link .tooltip-info-bottom #BVRRContainer .tf-header,\n.tooltip-link .tooltip-info-bottom #BVRRContainer .tf-tabs,\n.tooltip-link .tooltip-info-bottom #BVRRContainer .tf-tabs-panels,\n.tooltip-link .tooltip-info-bottom #BVRRContainer .tf-tabs-bottom {\n\tdisplay: none !important;\n}\n\n.tooltip-info-above.services-tooltip__body {\n\tdisplay: none;\n\tposition: absolute;\n\tz-index: 9999999;\n}\n\n.tooltip-info-above.services-tooltip__body .services-tooltip__body__text {\n\tcolor: #233A64;\n\tfont-size: 11px;\n\tdisplay: -webkit-box;\n\t-webkit-line-clamp: 4;\n\t-webkit-box-orient: vertical;\n\toverflow: hidden;\n\ttransition: none;\n}\n\n.tooltip-info-above.services-tooltip__body .services-tooltip__body__text.is-expanded {\n\tdisplay: block;\n\t-webkit-line-clamp: unset;\n}\n\n.tooltip-info-above.services-tooltip__body .services-tooltip-inner__title {\n\tfont-size: 11px !important;\n\tfont-weight: 600 !important;\n}\n\n.tooltip-info-above.services-tooltip__body__toggle {\n\tdisplay: inline-block;\n\tmargin-top: 6px;\n\tfont-size: 11px;\n\tfont-weight: 600;\n\tcolor: #0d1f4c;\n\ttext-decoration: underline;\n\tcursor: pointer;\n\tbackground: none;\n\tborder: none;\n\tpadding: 0;\n}\n\n.tooltip-info-above.services-tooltip__body__toggle:hover {\n\tcolor: #1a56db;\n}\n\n.tooltip-info-above.services-tooltip__body button {\n\tfloat: right;\n\tbackground: none;\n\tfont-size: 11px;\n\ttext-decoration: underline;\n\tcolor: #233A64;\n}\n\n.tooltip-link .tooltip-info-bottom {\nwidth: 500px;\n}\n\n.product-hero-heading-services-grid {\n\tposition: relative;\n\tdisplay: flex;\n\talign-items: stretch;\n\theight: 100%;\n}\n\n.product-hero-heading-services-card-label-wrapper {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: flex-start;\n\tgap: 12px;\n\n\twidth: 100%;\n\theight: 100%;\n\n\ttext-align: left;\n}\n\n.product-hero-heading-services-grid a {\n\ttext-decoration: none;\n\tcolor: inherit;\n\tdisplay: flex;\n\twidth: 100%;\n}\n\n.product-hero-heading-services-card {\n\tdisplay: flex;\n    align-items: center;\n\tjustify-content: center;\n\n\twidth: 100%;\n\theight: 48px !important;\n\n\tpadding: 0 16px;\n\n\tbackground-color: #F6F6F6;\n\tborder-radius: 4px;\n\n\ttransition: background-color 0.2s ease;\n\n\ttext-decoration: none;\n\n\tbox-sizing: border-box;\n\n\ttext-align: center;\n\n\toverflow: hidden;\n}\n\n\n\n.product-hero-heading-services-card-label-wrapper .related-service-icon {\n\twidth: 24px !important;\n\theight: 24px !important;\n\n\tmargin: 0 !important;\n\n\tflex-shrink: 0;\n}\n\n.product-hero-heading-services-card-label-wrapper .services-tooltip__title {\n\tfont-size: 11px !important;\n\tfont-weight: 400 !important;\n\ttext-wrap: auto;\n\tcolor: #011E41 !important;\n\tline-height: 18px !important;\n}\n\n.rating_count {\nfont-weight: 600;\n}\n\n.rating_based .rating_rating:nth-of-type(3) {\n    display: none;\n}\n\n/* Align the stars and text container to the top */\n.ratings {\n    display: flex !important;\n    align-items: flex-start !important;\n    gap: 8px; /* Space between stars and text */\n}\n \n/* Align the individual text elements (4.8, reviews, etc.) */\n.rating_based {\n    display: flex !important;\n    flex-wrap: wrap;\n    align-items: baseline !important;\n    gap: 4px; /* Space between text elements */\n    line-height: 1;\n}\n \n/* Optional: Fine-tune star position if they look slightly too high/low */\n.rating_stars {\n    margin-top: 2px;\n}\n\n.rating_stars.rating_stars-svg > svg.icon-stars {\n    fill: #e0e0e0 !important; /* Or any light gray color */\n}\n\n#product-details_heading_rating--inner .rating_stars.rating_stars-svg > svg.icon-stars {\n    fill: #B88923 !important;\n}\n/* Change color of rating stars */\n.rating_stars-svg--marked svg,\n.icon-stars {\n    fill: #B88923 !important;\n}\n \n/* Change color of rating progress bars */\n.fill .bin {\n    background-color: #B88923 !important;\n}\n\n.rating_based > :nth-child(3) {\n  display: none;\n}\n\n/* On mobile/touch devices, we can disable pointer events on the \n   container that triggers the scroll, if it's a separate element. */\n@media (pointer: coarse) {\n  .rating_stars.rating_stars-svg {\n    /* This allows the hover/popup logic to still function via touch \n       but can sometimes interfere with JS listeners. */\n    touch-action: manipulation;\n  }\n}\n\n@media (max-width: 768px) {\n\n\t.product-hero-heading-services-grid {\n\t\tgrid-column: span 3 !important;\n\t}\n\n\t.product-hero-heading-services-grid:only-child {\n\t\tgrid-column: 1 / -1 !important;\n\t}\n\n\t.product-hero-heading-services-grid:last-child:nth-child(odd) {\n\t\tgrid-column: 1 / -1 !important;\n\t}\n\n\t.product-hero-heading-services-grid:first-child:nth-last-child(3) ~ .product-hero-heading-services-grid:last-child {\n\t\tgrid-column: 1 / -1 !important;\n\t}\n\n\t.product-hero-heading-services-card {\n\t\tpadding: 0px;\n\t}\n\n\t.services-tooltip__title {\n\t\tfont-size: 11px;\n\t}\n\n\n}\n\n/* If the scroll is triggered by an anchor tag wrapping the stars: */\n@media (max-width: 768px) {\n  .ratings a {\n    cursor: default;\n    /* This prevents the link from being 'clickable' for navigation/scrolling */\n    pointer-events: none; \n  }\n  /* Re-enable for the stars if they need to show the popup */\n  .ratings a .rating_stars {\n    pointer-events: auto;\n  }\n}\n\n.tooltip-info-bottom-reviews {\n     width: 260px;\n    max-width: 260px;\n    min-width: 260px;\n\n    height: auto;\n    max-height: 200px;\n\n    padding: 12px;\n    box-sizing: border-box;\n \n    white-space: normal;   /* \u2705 allow wrapping */\n    word-wrap: break-word;\n \n    overflow: hidden;      /* \u2705 prevent overflow stretch */\n}\n\n.tooltip-info-bottom-reviews {\n    display: none;\n\toverflow: visible !important;\n}\n\n.tooltip-info-bottom-reviews.is-visible {\n    display: block;\n}\n\n/* Close Icon Logic */\n.v-modal__close-btn {\n    display: none; /* Hide on desktop */\n}\n\n@media (max-width: 768px) {\n    .v-modal__close-btn {\n        display: block !important;\n        position: absolute;\n        top: 10px;\n        right: 10px;\n        width: 24px;\n        height: 24px;\n        z-index: 999;\n    }\n    \n    /* Ensure title doesn't overlap the X icon */\n    .tooltip-info-bottom-reviews--title {\n        padding-right: 25px;\n    }\n}\n\n@media (max-width: 768px) {\n    /* Only show if the class is explicitly present on mobile */\n    .tooltip-link--hover-all:hover .tooltip-info-bottom-reviews {\n        display: none; \n    }\n    \n    .tooltip-info-bottom-reviews.is-visible {\n        display: block !important;\n    }\n}\n\n/* 1. Ensure the parent container spans the width of the stars */\n.tooltip-link {\n    position: relative;\n    display: inline-block;\n}\n\n/* 2. Position the tooltip relative to that parent */\n.tooltip-info-bottom-reviews {\n    position: absolute;\n    left: 25%; /* Move the left edge to the middle of the stars */\n    transform: translateX(-27%); /* Shift it back by half its own width */\n    top: 100%; /* Position it below */\n}\n\n\n/* =========================================\n   MOBILE: VERTICALLY STACKED EQUAL BOXES\n========================================= */\n\n@media (max-width: 768px) {\n\n\t.product-hero-heading-services-grid-wrapper,\n\t.product-details_heading__related-service {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: 12px;\n\t}\n\n\t.product-hero-heading-services-grid {\n\t\twidth: 100%;\n\t\tdisplay: flex;\n\t}\n\n.product-hero-heading-services-card {\n\twidth: 100%;\n\tmin-height: 48px !important;\n\n\tpadding: 12px 16px;\n\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\n\tbox-sizing: border-box;\n\n\ttext-align: center;\n}\n\n.product-hero-heading-services-card-label-wrapper,\n.product-hero-heading-services-card-label {\n\tdisplay: flex !important;\n\n\talign-items: center !important;\n\tjustify-content: flex-start !important;\n\n\tflex-direction: row !important;\n\n\twidth: 100% !important;\n\theight: 100% !important;\n\n\tmargin: 0 auto !important;\n\tpadding: 0 !important;\n\n\tcolumn-gap: 6px !important;\n\trow-gap: 0 !important;\n\ttext-align: left !important;\n\n\toverflow: hidden;\n\n\tflex: 1 1 auto;\n}\n\n.product-hero-heading-services-card-label-wrapper .services-tooltip__title {\n\tdisplay: flex !important;\n\n\talign-items: center !important;\n\tjustify-content: flex-start !important;\n\n\ttext-align: left !important;\n\n\theight: 100%;\n\n\tmargin: 0 !important;\n\n\tflex: 0 1 auto;\n}\n}</style>", "dependencies": []}]}]}], "weightDistributions": [{"entityId": "5973987264561152", "endOfRange": 5000}, {"entityId": "6661021171974144", "endOfRange": 10000}],