# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SECRET_KEY="your-server-only-supabase-secret-key"
# Dự án Supabase cũ có thể dùng SUPABASE_SERVICE_ROLE_KEY thay cho SUPABASE_SECRET_KEY.

# Auth.js / NextAuth
AUTH_SECRET="generate-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth
# Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Facebook OAuth
# Callback URL: http://localhost:3000/api/auth/callback/facebook
AUTH_FACEBOOK_ID="your-facebook-app-id"
AUTH_FACEBOOK_SECRET="your-facebook-app-secret"

# Support email (Gmail app password)
EMAIL_USER="support@example.com"
EMAIL_PASS="your-gmail-app-password"
SUPPORT_NOTIFICATION_EMAIL="support-team@example.com"

# AI shopping assistant (server only)
# AI_PROVIDER: auto | gemini | groq | openai
# In auto mode, the assistant tries Gemini, then Groq, then OpenAI.
# Without a valid key, it automatically uses the local catalog recommendation engine.
AI_PROVIDER="auto"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"

# VNPay Gateway Configuration (Sandbox)
VNP_TMNCODE=""
VNP_HASHSECRET=""
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURNURL="http://localhost:3000/api/checkout/vnpay-return"
NEXT_PUBLIC_VNP_RETURNURL="http://localhost:3000/checkout/vnpay-return"
